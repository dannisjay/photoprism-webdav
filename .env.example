# ===================== WebDAV 源（你的 Alist + 115）=====================
# Alist 的 WebDAV 地址：http://<alist所在IP>:5244/dav
#   PhotoPrism 与 Alist 同机时填内网 IP，不要写 localhost（容器内 localhost 不是宿主机）
WEBDAV_URL=http://192.168.1.10:5244/dav
# Alist 登录账号 / 密码（WebDAV 与网页登录同一套）
WEBDAV_USER=admin
WEBDAV_PASS=你的alist密码

# ===================== 选择要扫描的目录（可多个）=====================
# 格式： 远程路径:挂载名 ，多个用英文分号 ; 分隔
#   远程路径 = 在 Alist 网页界面看到的路径，去掉前导 /（例：/115/照片 → 115/照片）
#   挂载名   = 你在 PhotoPrism 里看到的文件夹名（建议字母数字，不能含 /）
# 例：
#   WEBDAV_MOUNTS=115/照片:photos;115/视频:videos
# 也可以不写挂载名，自动取目录最后一段：
#   WEBDAV_MOUNTS=115/照片;115/视频
# 以后要加/减目录：改这一行 → docker compose up -d → 重新索引即可，无需重编译镜像
WEBDAV_MOUNTS=115/照片:photos;115/视频:videos
# 旧变量 WEBDAV_PATH=115/照片 仍兼容（只能填一个目录）

# ===================== rclone 容错 / 缓存（可选，有默认值）=====================
# 原图磁盘缓存：开启后"看过的原图"会落在服务器本地（./storage/rclone-vfs），
# Alist 断线时已看过的图仍能看大图；上限到了自动淘汰最旧的。
# 注意：会占用本地磁盘（上限见下一行），按你库的大小与磁盘剩余空间调整。
RCLONE_VFS_CACHE=true
RCLONE_VFS_CACHE_MAX_SIZE=50G
# 连接/读写超时与重试次数（瞬时抖动容错）
RCLONE_CONTIMEOUT=10s
RCLONE_TIMEOUT=5m
RCLONE_RETRIES=3
RCLONE_LOW_LEVEL_RETRIES=20

# ===================== PhotoPrism =====================
# 浏览器访问地址，改成你的服务器 IP
PHOTOPRISM_SITE_URL=http://你的服务器IP:2342/
# 初始管理员密码（至少 8 位，仅首次启动生效）
PHOTOPRISM_ADMIN_PASSWORD=换成强密码

# ===================== MariaDB（索引数据库）=====================
# 存放 PhotoPrism 的"图片记录"（哪张照片、路径、标签、人物关系等），不是图片本身。
# 数据落在服务器 ./database 目录。密码建议只用字母数字。
MARIADB_PASSWORD=photoprism-db-pass
MARIADB_ROOT_PASSWORD=photoprism-db-root-pass